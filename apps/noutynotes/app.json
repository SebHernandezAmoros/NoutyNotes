{
  "expo": {
    "name": "NoutyNotes",
    "slug": "noutynotes",
    "version": "0.1.0",
    "scheme": "noutynotes",
    "userInterfaceStyle": "automatic",
    "platforms": ["android", "web"],
    "android": { "package": "com.noutynotes.app" },
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "NoutyNotes",
      "description": "Un lugar para tus ideas. Notas, tableros y conexiones en tu propio espacio."
    },
    "plugins": ["expo-router"]
  }
}
